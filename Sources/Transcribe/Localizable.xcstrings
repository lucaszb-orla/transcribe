    "Ao encerrar cada transcrição, salva uma cópia em Markdown (.md) na pasta escolhida, além do que o app já guarda por conta própria.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When each transcript ends, saves a Markdown (.md) copy to the chosen folder, in addition to what the app already stores on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al finalizar cada transcripción, guarda una copia en Markdown (.md) en la carpeta elegida, además de lo que la app ya guarda por su cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la fin de chaque transcription, enregistre une copie en Markdown (.md) dans le dossier choisi, en plus de ce que l’app conserve déjà elle-même."
          }
        }
      }
    },
