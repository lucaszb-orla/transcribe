    "O Apple Intelligence não está ativado. Ative em Ajustes do Sistema › Apple Intelligence e Siri para gerar resumos automáticos.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence isn't turned on. Turn it on in System Settings › Apple Intelligence & Siri to generate automatic summaries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence no está activado. Actívalo en Ajustes del Sistema › Apple Intelligence y Siri para generar resúmenes automáticos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence n’est pas activé. Activez-le dans Réglages Système › Apple Intelligence et Siri pour générer des résumés automatiques."
          }
        }
      }
    },
    "O Apple Intelligence recusou processar esse conteúdo por segurança.": {
      "localizations": {
        "en": {
