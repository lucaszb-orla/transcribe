    "Aberto no Terminal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opened in Terminal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abierto en Terminal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvert dans le Terminal"
          }
        }
      }
    },
    "Abre um Terminal e deixa o Claude Code implementar, commitar, dar push e abrir Pull Request sozinho, sem pedir confirmação a cada passo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a Terminal and lets Claude Code implement, commit, push, and open a Pull Request on its own, without asking for confirmation at every step."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una Terminal y deja que Claude Code implemente, haga commit, push y abra un Pull Request por su cuenta, sin pedir confirmación en cada paso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre un Terminal et laisse Claude Code implémenter, committer, pousser et ouvrir une Pull Request tout seul, sans demander de confirmation à chaque étape."
          }
        }
      }
    },
