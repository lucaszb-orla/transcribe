    "A pasta escolhida não existe mais ou não é um repositório git válido.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chosen folder no longer exists or isn't a valid git repository."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta elegida ya no existe o no es un repositorio git válido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier choisi n’existe plus ou n’est pas un dépôt git valide."
          }
        }
      }
    },
    "A reunião foi salva, mas não deu pra copiar em Markdown para a pasta escolhida: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The meeting was saved, but it wasn't possible to copy it as Markdown to the chosen folder: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reunión se guardó, pero no fue posible copiarla en Markdown a la carpeta elegida: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réunion a été enregistrée, mais impossible de la copier en Markdown dans le dossier choisi : %@"
          }
        }
      }
    },
    "A transcrição on-device espera este idioma. Fale nele para melhores resultados.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device transcription expects this language. Speak in it for better results."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción en el dispositivo espera este idioma. Háblalo para obtener mejores resultados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription sur l’appareil attend cette langue. Parlez dans cette langue pour de meilleurs résultats."
          }
        }
      }
    },
    "A transcrição será salva. Você pode retomá-la depois abrindo a reunião.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transcript will be saved. You can resume it later by opening the meeting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción se guardará. Puedes retomarla después abriendo la reunión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription sera enregistrée. Vous pourrez la reprendre plus tard en ouvrant la réunion."
          }
        }
      }
    },
    "ACESSOS ESSENCIAIS": {
      "localizations": {
        "en": {
