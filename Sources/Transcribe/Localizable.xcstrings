    "Isso vai abrir %@ e deixar o Claude Code implementar, commitar, dar push e abrir Pull Request sozinho em “%@”.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will open %1$@ and let Claude Code implement, commit, push, and open a Pull Request on its own in “%2$@”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto abrirá %1$@ y dejará que Claude Code implemente, haga commit, push y abra un Pull Request por su cuenta en “%2$@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela va ouvrir %1$@ et laisser Claude Code implémenter, committer, pousser et ouvrir une Pull Request tout seul dans « %2$@ »."
          }
        },
        "pt-BR": {
