          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcribe a besoin du microphone pour enregistrer votre voix pendant les réunions."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcribe precisa do microfone para gravar sua fala durante as reuniões."
          }
        }
      }
