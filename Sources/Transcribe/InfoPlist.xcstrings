    "NSCalendarsFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcribe reads your Calendar to suggest starting a recording when a meeting with a call link is about to begin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcribe lee tu Calendario para sugerir el inicio de la grabación cuando una reunión con enlace de llamada está por comenzar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcribe lit votre Calendrier pour suggérer le démarrage d’un enregistrement quand une réunion avec un lien d’appel est sur le point de commencer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcribe lê seu Calendário para sugerir o início da gravação quando uma reunião com link de chamada está prestes a começar."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
